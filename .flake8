[flake8]
max-line-length = 160
# E402: module level import not at top of file (common in Ansible modules)
# W503: line break before binary operator (conflicts with PEP 8 update)
extend-ignore = E402, W503
exclude =
    .git,
    __pycache__,
    docs,
    venv-docs,
    build,
    dist
per-file-ignores =
    # Ansible modules use * imports and have specific patterns
    plugins/modules/*.py: F401
